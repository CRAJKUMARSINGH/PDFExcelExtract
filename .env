# Environment variables for PDFExcelExtract

# Database connection string (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/pdfextract

# Session secret for Express.js sessions
SESSION_SECRET=your_super_secret_session_key_change_this_in_production

# Port for the application (default: 5000)
PORT=5000

# Node environment
NODE_ENV=development

# Tesseract OCR path (if not in PATH)
# TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe